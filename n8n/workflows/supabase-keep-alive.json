      "id": "eb7739a9-0db6-4888-86f7-ead38b4a42e9",
      "credentials": {
        "postgres": {
          "id": "gw1ZfzaClLagb7Jx",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Every 2 days": {
      "main": [
        [
          {
            "node": "Ping Supabase API",
